// Helper functions callable from ACS (ScriptCall).
class DCX_Util
{
	// True if the Unofficial Xtras addon's weapons (H2P_*, DCX_DZ0PlasmaRifle) are loaded.
	// Lets the "WeaponManagement" ACS script skip them silently when they aren't.
	clearscope static int OEWeaponsLoaded()
	{
		String name = "H2P_RocketLauncher";
		class<Actor> cls = name;
		return cls != null ? 1 : 0;
	}
}
