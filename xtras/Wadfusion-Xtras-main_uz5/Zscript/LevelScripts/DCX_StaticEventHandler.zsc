// Wadfusion Xtras - static handler
//
// Ported to WadFusion 1.6.x (UZDoom 5). The old version of this file replaced most of
// WadFusionStaticHandler and copied WadFusion's full run / title screen code. WadFusion now does
// all of that itself (wf_fullrun.zs / wf_story.zs), so this handler is a small add-on that runs NEXT TO
// WadFusion's own handler (it is a separate instance, not a replacement) and only adds what Xtras needs:
//   * the PlayStation versions of E3M1 (dcx_playstationmaps)
//   * title screens and music for the Xtras-only episodes
//       (Jaguar, Absolution, Doom II / TNT / Plutonia part 2 and 3 hack maps)
//   * Full Run: Jaguar and Absolution are appended to WadFusion's Full Run chain
//
// WadFusion's handler is registered first, so on every tick it runs before this one. That lets this
// handler adjust the state WadFusion just computed (nextMap / intermission) before it is used.

class DCX_StaticHandler : StaticEventHandler
{
	String dcxCurrentMap;  // map we are on
	String dcxPreviousMap; // map we came from
	String dcxEndSource;   // last map of an Xtras episode while a Full Run hands over (see DCX_FullRunHook)
	String dcxNext;        // where the hand-over map goes next
	String dcxIntermission;

	WadFusionStaticHandler DCX_Base()
	{
		return WadFusionStaticHandler(StaticEventHandler.Find("WadFusionStaticHandler"));
	}

	override void WorldLoaded(WorldEvent e)
	{
		dcxPreviousMap = dcxCurrentMap;
		dcxCurrentMap = Level.MapName.MakeLower();

		bool hackMap = dcxCurrentMap.Left(10) == "wf_newgame" || dcxCurrentMap.Left(10) == "wf_endgame"
			|| dcxCurrentMap.Left(8) == "wf_story" || dcxCurrentMap == "dcx_handover";
		if ( !hackMap )
			dcxEndSource = "";
	}

	override void WorldTick()
	{
		String mapName = Level.MapName.MakeLower();

		if ( mapName.Left(10) == "wf_newgame" )
			DCX_NewGameTitle(mapName);
		else if ( mapName == "e3m1" )
			DCX_PlaystationRedirect();
		else if ( mapName.Left(10) == "wf_endgame" )
		{
			if ( Level.MapTime == 0 )
				DCX_AppendToChain(mapName.Mid(11));
		}
		else if ( mapName == "dcx_handover" )
			DCX_EndGame();
		else
			DCX_FullRunHook(mapName);
	}

	override void RenderOverlay(RenderEvent e)
	{
		// the hand-over map is only a place to show an intermission from, so hide the map behind it
		if ( Level.MapName.MakeLower() == "dcx_handover" )
		{
			Level.SetFrozen(true);
			Screen.DrawTexture(TexMan.CheckForTexture("TITLEPIC"), false, 0, 0, DTA_FullScreen, 1);
		}
	}

	void DCX_StartIntermission(String name)
	{
		let wfHandler = DCX_Base();
		if ( !wfHandler || name == "" )
			return;

		// WadFusion's helper starts it locally, or sends a network event in multiplayer
		wfHandler.intermission = name;
		wfHandler.StoryStartIntermission();
	}

	void DCX_ChangeLevel(String target)
	{
		let isPistolStart = CVar.FindCVar("wf_compat_pistolstart").GetBool();
		let pistolStart = CHANGELEVEL_RESETINVENTORY|CHANGELEVEL_RESETHEALTH|CHANGELEVEL_NOINTERMISSION;

		Level.ChangeLevel(target, 0, isPistolStart ? pistolStart : CHANGELEVEL_NOINTERMISSION);
	}

	//-------------------------------------------------------------------------
	// PlayStation E3M1
	//-------------------------------------------------------------------------

	// WadFusion sends the player to E3M1 after E2M8 (Full Run, or the Episode 3 menu entry).
	// With dcx_playstationmaps set, continue on to the PlayStation version straight away.
	void DCX_PlaystationRedirect()
	{
		if ( Level.MapTime != 0 )
			return;
		if ( dcxPreviousMap != "wf_newgame_e3m1" && dcxPreviousMap != "e2m8" )
			return;

		int psx = CVar.FindCVar("dcx_playstationmaps").GetInt();
		if ( psx == 2 )
			DCX_ChangeLevel("psx02b");
		else if ( psx == 1 )
			DCX_ChangeLevel("psx02");
	}

	//-------------------------------------------------------------------------
	// Title screens for the Xtras-only episodes
	//-------------------------------------------------------------------------

	// WadFusion already changes level from wf_newgame_* maps to the right episode, but it only knows
	// its own episodes' title screens. For the Xtras-only ones, show a title screen here.
	void DCX_NewGameTitle(String mapName)
	{
		if ( Level.MapTime != 0 )
			return;
		if ( !CVar.FindCVar("wf_compat_titlepics").GetBool() )
			return;

		String target = mapName.Mid(11);
		String titleMusic;
		String title;

		if ( target == "ja_map01" )
		{
			titleMusic = "O_INTRO";
			title      = "Dcx_Title_Jaguar";
		}
		else if ( target == "map12" || target == "map21" )
		{
			titleMusic = "d_dm2ttl";
			title      = "Doom2_Title";
		}
		else if ( target == "tn_map12" || target == "tn_map21" )
		{
			titleMusic = "t_dm2ttl";
			title      = "Tnt_Title";
		}
		else if ( target == "pl_map12" || target == "pl_map21" )
		{
			titleMusic = "p_dm2ttl";
			title      = "Plutonia_Title";
		}
		else if ( target == "ab_map01" || target == "ab_map12" || target == "ab_map21" )
		{
			titleMusic = "D_TITLEA";
			title      = "Dcx_Title_Absolution";
			if ( target == "ab_map01" && CVar.FindCVar("wf_intros").GetBool() )
				title = "Dcx_Title_Absolution_Intro";
		}
		else
			return;

		S_ChangeMusic(titleMusic, 0, false);
		DCX_StartIntermission(title);
	}

	//-------------------------------------------------------------------------
	// Full Run
	//-------------------------------------------------------------------------

	// Last map of Jaguar / Absolution: during a Full Run, exit to the hand-over map instead of the normal ending.
	void DCX_FullRunHook(String mapName)
	{
		if ( mapName != "ja_map24" && mapName != "ab_map30" )
			return;
		if ( !CVar.FindCVar("wf_compat_nextmap").GetBool() )
			return;

		int fullRun = CVar.FindCVar("wf_fullrun").GetInt();
		if ( fullRun < 1 || fullRun > 3 )
			return;

		dcxEndSource = mapName;
		Level.NextMap = "dcx_handover";
		Level.NextSecretMap = "dcx_handover";
	}

	// First Xtras episode in the Full Run, or "" if the Xtras maps aren't installed.
	String DCX_FirstXtrasEpisode()
	{
		if ( Wads.CheckNumForFullName("maps/ja_map01.wad") != -1 )
			return "wf_newgame_ja_map01";
		if ( Wads.CheckNumForFullName("maps/ab_map01.wad") != -1 )
			return "wf_newgame_ab_map01";
		return "";
	}

	// Where a Full Run goes after the last Xtras episode: back to the start if "Full Run loop" is on.
	String DCX_LoopTarget()
	{
		if ( !CVar.FindCVar("wf_fullrun_loop").GetBool() )
			return "";

		String starts[] = { "e1m1", "e2m1", "e3m1", "e4m1", "e5m1", "e6m1", "map01", "nv_map01", "lr_map01", "tn_map01", "pl_map01" };
		for ( int i = 0; i < starts.Size(); i++ )
		{
			if ( Wads.CheckNumForFullName("maps/"..starts[i]..".wad") != -1 )
				return "wf_newgame_"..starts[i];
		}
		return "";
	}

	// First tick of one of WadFusion's wf_endgame_* maps, after WadFusion chose the next episode.
	// If it has nothing left (or would loop back to the start), continue with the Xtras episodes.
	void DCX_AppendToChain(String endMap)
	{
		let wfHandler = DCX_Base();
		if ( !wfHandler )
			return;

		int fullRun = CVar.FindCVar("wf_fullrun").GetInt();
		if ( fullRun < 1 || fullRun > 3 )
			return;

		String first = DCX_FirstXtrasEpisode();
		if ( first == "" )
			return;

		// the last episode of each Full Run order
		String lastOfOrder = fullRun == 1 ? "pl_map30" : "lr_map14";
		bool wouldLoop = CVar.FindCVar("wf_fullrun_loop").GetBool() && endMap == lastOfOrder;

		if ( wfHandler.nextMap == "" || wouldLoop )
			wfHandler.nextMap = first;
	}

	// Hand-over map: reached from the last map of an Xtras episode during a Full Run.
	void DCX_EndGame()
	{
		if ( Level.MapTime == 0 )
		{
			bool cast = CVar.FindCVar("wf_fullrun_cast").GetBool();
			int fullRun = CVar.FindCVar("wf_fullrun").GetInt();
			bool fullRunOn = fullRun >= 1 && fullRun <= 3;

			dcxIntermission = "";
			dcxNext = "";

			if ( dcxEndSource == "ja_map24" )
			{
				dcxIntermission = "Jaguar_Cast";
				if ( fullRunOn && Wads.CheckNumForFullName("maps/ab_map01.wad") != -1 )
					dcxNext = "wf_newgame_ab_map01";
				else if ( fullRunOn )
					dcxNext = DCX_LoopTarget();
			}
			else if ( dcxEndSource == "ab_map30" )
			{
				dcxIntermission = "D64Inter_Cast";
				if ( fullRunOn )
					dcxNext = DCX_LoopTarget();
			}

			// Full Run without cast sequences goes straight on to the next episode
			if ( fullRunOn && !cast && dcxNext != "" )
				dcxIntermission = "";

			DCX_StartIntermission(dcxIntermission);
		}

		if ( Level.MapTime >= 1 )
			DCX_ChangeLevel(dcxNext);
	}
}
